FROM node:22-alpine AS base
WORKDIR /app

# Ferramentas de build para better-sqlite3 (node-gyp)
RUN apk add --no-cache python3 make g++

# Copia package.json de TODOS os workspaces para satisfazer o lockfile
COPY package.json package-lock.json tsconfig.base.json ./
COPY pacotes/protocolo/package.json     pacotes/protocolo/
COPY pacotes/processamento/package.json pacotes/processamento/
COPY pacotes/analise/package.json       pacotes/analise/
COPY pacotes/relatorio/package.json     pacotes/relatorio/
COPY pacotes/gateway/package.json       pacotes/gateway/
COPY pacotes/api/package.json           pacotes/api/
COPY pacotes/aplicacao/package.json     pacotes/aplicacao/
COPY pacotes/atualizador/package.json   pacotes/atualizador/
COPY ponta-a-ponta/package.json         ponta-a-ponta/

# Instala todas as deps (inclui typescript para compilação)
RUN --mount=type=cache,target=/root/.npm \
    npm ci --workspace=pacotes/api

# Copia fontes e compila TypeScript
COPY pacotes/api/src           pacotes/api/src
COPY pacotes/api/tsconfig.json pacotes/api/
RUN npm run compilar --workspace=pacotes/api

# Remove devDependencies para imagem final menor
RUN npm prune --omit=dev

# ── Imagem final ────────────────────────────────────────────────────────────
FROM node:22-alpine
WORKDIR /app

COPY --from=base /app/node_modules             ./node_modules
COPY --from=base /app/pacotes/api/dist         ./pacotes/api/dist
COPY --from=base /app/pacotes/api/package.json ./pacotes/api/
COPY --from=base /app/package.json             ./

RUN mkdir -p /dados && chown node:node /dados
USER node

ENV CAMINHO_BANCO=/dados/balanca.db
ENV PORTA_API=3000
ENV NODE_ENV=production

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/saude || exit 1

CMD ["node", "pacotes/api/dist/principal.js"]
