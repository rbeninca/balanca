<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Leitura da balança pela USB Host API (o TX9 declara android.hardware.usb.host) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Hotspot balancaGFIG (ver sistema/HotspotManager.kt, herdado do IFRede) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!--
      WRITE_SETTINGS é o que libera setWifiApEnabled neste firmware
      (net.tethering.noprovisioning=true); é concedida por
      `appops set br.edu.ifsc.balancagfig WRITE_SETTINGS allow` (scripts/preparar-tx9.sh).
      ACCESS_SUPERUSER é esperada pelo Superuser (Koush) do TX9 para o pedido de
      root usado no DHCP/NAT do hotspot.
    -->
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED" tools:ignore="ProtectedPermissions" />
    <!--
      Alguns firmwares (ex.: Rockchip rk322x/MXQ) exigem WRITE_SECURE_SETTINGS
      dentro do próprio setWifiApEnabled via reflexão, além do app-op
      WRITE_SETTINGS que basta no TX9 (Amlogic). É uma permissão "signature":
      fica sem efeito até ser concedida via `pm grant` pelo instalador
      (scripts/preparar-tx9.sh), que roda com ADB root.
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.BalancaGFIG">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Aparece também no launcher de TV do TX9 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!--
              Ao plugar a balança, o Android abre o app e concede a permissão USB
              sem diálogo — essencial para operação em quiosque.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/filtro_usb" />
        </activity>

        <service
            android:name=".ServicoBalanca"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".ReceptorBoot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Após a atualização automática (pm install -r), religa serviço e tela -->
        <receiver
            android:name=".atualizacao.ReceptorAtualizacao"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
